# Copy to .env and fill in. See SETUP.md.

# Supabase (Project Settings → API). The URL and publishable key are public;
# the service-role key bypasses all security rules — server and scripts only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# AI: Gemini first, Claude as the backup.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Voice: text-to-speech and speech-to-text.
ELEVENLABS_API_KEY=
